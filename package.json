{
  "name": "nidhi-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "cross-env EXPO_OFFLINE=1 expo start",
    "start:online": "expo start",
    "android": "cross-env EXPO_OFFLINE=1 expo run:android",
    "ios": "cross-env EXPO_OFFLINE=1 expo run:ios",
    "web": "cross-env EXPO_OFFLINE=1 expo start --web",
    "dev:android": "cross-env EXPO_OFFLINE=1 expo run:android",
    "dev:ios": "cross-env EXPO_OFFLINE=1 expo run:ios",
    "lint": "eslint .",
    "ts:check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "audit": "node scripts/audit.js",
    "audit:fix": "npm audit fix --legacy-peer-deps",
    "prebuild": "cross-env EXPO_OFFLINE=1 expo prebuild",
    "build:apk": "eas build -p android --profile preview",
    "build:aab": "eas build -p android --profile production",
    "build:ios": "eas build -p ios --profile production",
    "verify": "npm run ts:check && npm run lint && npm run test",
    "postinstall": "node scripts/postinstall-patch.js"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.26",
    "expo-asset": "~57.0.18",
    "expo-audio": "~57.0.5",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.19",
    "expo-dev-client": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.11",
    "expo-localization": "~57.0.2",
    "expo-notifications": "~57.0.21",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "lucide-react-native": "^1.48.0",
    "react": "19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-google-mobile-ads": "^17.2.0",
    "react-native-purchases": "^10.10.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.27.0",
    "@babel/preset-env": "^7.27.0",
    "@expo/config-types": "^57.0.2",
    "@react-native/assets-registry": "^0.86.3",
    "@react-native/jest-preset": "^0.86.3",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.12",
    "@types/react": "~19.3.0",
    "babel-jest": "^29.7.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "nativewind": "^4.2.7",
    "react-native-worklets": "0.10.1",
    "typescript": "^5.7.0"
  },
  "overrides": {
    "tar": "^6.2.1",
    "nanoid": "^5.0.7",
    "minimatch": "^3.1.2",
    "postcss": "^8.4.47",
    "node-forge": "^1.3.1",
    "image-size": "^1.1.0",
    "form-data": "^4.0.1",
    "@xmldom/xmldom": "^0.8.10",
    "uuid": "^10.0.0",
    "ajv": "^6.12.6",
    "joi": "^17.13.3",
    "yaml": "^2.5.1",
    "cacache": "^18.0.4"
    "braces": "^3.0.3"
  },
  "private": true
}
